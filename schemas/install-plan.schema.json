{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cdf.local/schemas/install-plan.schema.json",
  "title":"CDF v2 CLI plan output",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","action","state","scope","target","planned_actions","conflicts","warnings"],
  "properties":{
    "schema":{"const":1},
    "action":{"enum":["install","upgrade","uninstall","recover"]},
    "state":{"enum":["ready","conflict","recovery-required"]},
    "scope":{"enum":["project","global"]},
    "target":{"type":"string"},
    "planned_actions":{"type":"array","items":{"type":"object","required":["path","operation"],"properties":{"path":{"type":"string"},"operation":{"enum":["add","update","remove","unchanged"]},"before_sha256":{"type":["string","null"]},"after_sha256":{"type":["string","null"]}}}},
    "conflicts":{"type":"array","items":{"type":"string"}},
    "warnings":{"type":"array","items":{"type":"string"}}
  }
}
