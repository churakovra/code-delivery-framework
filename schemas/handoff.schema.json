{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdf.local/schemas/handoff.schema.json",
  "title": "CDF v2 delegated assignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","task_id","role","objective","baseline","scope","accepted_decisions","acceptance","permissions","evidence_requested"],
  "properties": {
    "schema": {"const": 1},
    "task_id": {"type": "string","minLength": 1},
    "role": {"enum": ["worker","explorer","cdf_reviewer","cdf_diagnostician"]},
    "objective": {"type": "string","minLength": 1},
    "baseline": {"type":"object","required":["revision","dirty_paths"],"additionalProperties":false,"properties":{"revision":{"type":"string"},"dirty_paths":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},
    "scope": {"type":"object","required":["read_paths","write_paths"],"additionalProperties":false,"properties":{"read_paths":{"type":"array","items":{"type":"string"}},"write_paths":{"type":"array","items":{"type":"string"}}}},
    "accepted_decisions": {"type":"array","items":{"type":"string"}},
    "acceptance": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "permissions": {"type":"array","items":{"type":"string"}},
    "evidence_requested": {"type":"array","items":{"type":"string"}},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "source_findings": {"type":"array","items":{"type":"string"}},
    "subskills": {"type":"array","items":{"type":"string"}},
    "model_request": {"type":"object","additionalProperties":false,"required":["model","effort","verification"],"properties":{"model":{"type":["string","null"]},"effort":{"type":["string","null"]},"verification":{"enum":["unknown","requested","confirmed","mismatch"]}}}
  }
}
