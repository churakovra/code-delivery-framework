{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdf.local/schemas/eval-run.schema.json",
  "title": "CDF v2 observed evaluation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "condition",
    "seed",
    "runtime_version",
    "model_requested",
    "model_observed",
    "result",
    "acceptance_checks",
    "resource_measurement",
    "raw_trace_path",
    "rubric_version",
    "activation_result",
    "activation_checks"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "case_id": {
      "type": "string"
    },
    "condition": {
      "enum": [
        "BASE",
        "CDF_06",
        "CDF_20"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "runtime_version": {
      "type": "string"
    },
    "model_requested": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_observed": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_OBSERVED",
        "BLOCKED",
        "RUNNER_ERROR"
      ]
    },
    "acceptance_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_OBSERVED",
              "SKIPPED"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "resource_measurement": {
      "type": "object",
      "required": [
        "basis"
      ],
      "properties": {
        "basis": {
          "enum": [
            "observed_runtime",
            "coarse_account_proxy",
            "not_available"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cached_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "raw_trace_path": {
      "type": "string"
    },
    "rubric_version": {
      "const": 2
    },
    "activation_result": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_OBSERVED",
        "NOT_APPLICABLE",
        "RUNNER_ERROR"
      ]
    },
    "activation_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_OBSERVED",
              "SKIPPED"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
