{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdf.local/schemas/task-state.schema.json",
  "title": "CDF v2 optional task checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","intent","state","objective","accepted_decisions","open_material_questions","acceptance","risk","review_required"],
  "properties": {
    "schema": {"const":1},
    "intent": {"enum":["EXPLAIN","EXPLORE","AUDIT","PLAN","IMPLEMENT","OPERATION","MIXED"]},
    "state": {"enum":["RECEIVED","CLASSIFIED","DISCOVERING","NEEDS_USER","WAITING_FOR_USER","READY","PLANNING","IMPLEMENTING","DIAGNOSING","VERIFYING","REVIEWING","DELIVERED","EXPLANATION_COMPLETE","EXPLORATORY_COMPLETE","BLOCKED_ENVIRONMENT","BLOCKED_REVIEW","STOPPED_BY_USER","PARTIAL_DELIVERY","FAILED_WITH_EVIDENCE"]},
    "objective": {"type":"string","minLength":1},
    "baseline": {"type":"object","additionalProperties":true},
    "accepted_decisions": {"type":"array","items":{"type":"object","required":["id","decision","source"],"properties":{"id":{"type":"string"},"decision":{"type":"string"},"source":{"type":"string"}}}},
    "open_material_questions": {"type":"array","items":{"type":"string"}},
    "acceptance": {"type":"array","items":{"type":"string"}},
    "scope": {"type":"array","items":{"type":"string"}},
    "risk": {"enum":["LOW","MEDIUM","HIGH"]},
    "review_required": {"type":"boolean"},
    "verification": {"type":"object","additionalProperties":true}
  }
}
